# All optional. Sensible defaults are applied when these are unset:
# development -> http://localhost:8000, production -> same origin.

# REST API base URL
VITE_API_URL="http://localhost:8000/api"

# Socket.IO server URL
VITE_SOCKET_URL="http://localhost:8000"

# Target for the Vite dev proxy (/api and /socket.io)
VITE_SERVER_URL="http://localhost:8000"
