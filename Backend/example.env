# Port the API + Socket.IO server listens on
PORT=8000

# MongoDB connection string
MONGO_URL="mongodb://127.0.0.1:27017/thinkink"

# Secret used to sign JWTs - use a long random string
JWT_SECRET=""

# How long an issued token stays valid (e.g. 7d, 24h, 30m)
JWT_LIFETIME="7d"

# Origin allowed by CORS and Socket.IO
CLIENT_URL="http://localhost:5173"

# Set to "production" to enable CSP and disable the Socket.IO admin UI
NODE_ENV=development
